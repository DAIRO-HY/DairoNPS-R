use std::collections::HashMap;
use std::sync::{Mutex, OnceLock};

#[derive(Debug)]
struct TCPPool {
    id: u64,
    // 你的其他字段……
}

// 全局静态
static POOLS: OnceLock<Mutex<HashMap<u64, Vec<TCPPool>>>> = OnceLock::new();

fn pools() -> &'static Mutex<HashMap<u64, Vec<TCPPool>>> {
    // 惰性初始化：第一次访问时创建
    POOLS.get_or_init(|| Mutex::new(HashMap::new()))
}
fn add_pool(key: u64, pool: TCPPool) {
    let mut guard = POOLS.get().unwrap().lock().expect("Mutex poisoned");

    // 如果 key 不存在则插入空 Vec，再 push
    guard.entry(key).or_default().push(pool);
}
fn extend_pools(key: u64, new_items: Vec<TCPPool>) {
    let mut guard = pools().lock().expect("Mutex poisoned");
    guard.entry(key).or_default().extend(new_items);
}
fn remove_by_index(key: u64, index: usize) -> Option<TCPPool> {
    let mut guard = pools().lock().expect("Mutex poisoned");
    if let Some(vec) = guard.get_mut(&key) {
        if index < vec.len() {
            // 不关心顺序时推荐：O(1)
            return Some(vec.swap_remove(index));
            // 若要保持顺序：return Some(vec.remove(index));
        }
    }
    None
}
fn remove_by_predicate<F>(key: u64, mut pred: F) -> usize
where
    F: FnMut(&TCPPool) -> bool,
{
    // 语义：保留 pred 返回 true 的元素 => 删除返回 false 的元素
    let mut guard = pools().lock().expect("Mutex poisoned");
    if let Some(vec) = guard.get_mut(&key) {
        let old_len = vec.len();
        vec.retain(|p| pred(p)); // 例如 pred = |p| p.id != 42 表示删除 id=42
        return old_len - vec.len();
    }
    0
}
fn clear_key(key: u64) {
    let mut guard = pools().lock().expect("Mutex poisoned");
    if let Some(vec) = guard.get_mut(&key) {
        vec.clear();
    }
}
fn remove_key(key: u64) -> Option<Vec<TCPPool>> {
    let mut guard = pools().lock().expect("Mutex poisoned");
    guard.remove(&key)
}
fn list_ids_under(key: u64) -> Vec<u64> {
    let guard = pools().lock().expect("Mutex poisoned");
    guard.get(&key)
        .map(|vec| vec.iter().map(|p| p.id).collect())
        .unwrap_or_default()
}
fn main() {
    // 添加
    add_pool(1, TCPPool { id: 100 });
    add_pool(1, TCPPool { id: 101 });
    extend_pools(2, vec![TCPPool { id: 200 }, TCPPool { id: 201 }]);

    // 读取
    println!("key=1 ids = {:?}", list_ids_under(1));
    println!("key=2 ids = {:?}", list_ids_under(2));

    // 删除指定下标
    let removed = remove_by_index(1, 0);
    println!("removed from key=1: {:?}", removed);
    println!("key=1 ids after remove = {:?}", list_ids_under(1));

    // 按条件删除：删除 id=201
    let removed_cnt = remove_by_predicate(2, |p| p.id != 201);
    println!("removed {} from key=2 (kept !=201)", removed_cnt);
    println!("key=2 ids after predicate = {:?}", list_ids_under(2));

    // 清空某个 key
    clear_key(1);
    println!("key=1 after clear = {:?}", list_ids_under(1));

    // 删除整个 key
    let v = remove_key(2);
    println!("removed key=2 vec = {:?}", v.map(|x| x.len()));
}