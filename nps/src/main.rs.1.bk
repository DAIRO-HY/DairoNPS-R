// 放在某个模块或crate的lib.rs/mod.rs中
#[macro_export]
macro_rules! make_string_struct {
    ($name:ident, $field:ident) => {
        pub struct $name {
            $field: String,
        }

        impl $name {
            pub fn new() -> Self {
                Self {
                    $field: String::new(),
                }
            }

            pub fn from(value: String) -> Self {
                Self { $field: value }
            }

            // pub fn get_value(&self) -> String {
            //     self.$field.clone()
            // }
        }
    };
}

#[tokio::main]
