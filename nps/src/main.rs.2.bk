#[macro_export]
macro_rules! make_string_struct_without_getter_with_str {
    ($name:ident, $field:ident) => {
        pub struct $name {
            $field: String,
        }

        impl $name {
            pub fn new() -> Self {
                Self { $field: String::new() }
            }

            pub fn from(value: String) -> Self {
                Self { $field: value }
            }

            pub fn from_str(value: &str) -> Self {
                Self { $field: value.to_string() }
            }
        }
    };
}

make_string_struct_without_getter_with_str!(MacuroDemo, value);

impl MacuroDemo {
    pub fn get_value(&self) -> String {
        self.value.clone()
    }
}

fn main() {
    let a = MacuroDemo::new();
    let b = MacuroDemo::from("hello".to_string());

    assert_eq!(a.get_value(), "");       // new() -> 空字符串
    assert_eq!(b.get_value(), "hello");

    println!("a: {}, b: {}", a.get_value(), b.get_value());
}
