use axum::{
    Router,
    extract::Path,
    http::{StatusCode, header},
    response::{IntoResponse, Response},
    routing::get,
};
use rust_embed::RustEmbed;
use mime_guess::mime;

#[derive(RustEmbed)]
#[folder = "assets/static/"]
struct Static;

/// 处理静态文件请求
pub async fn handler(Path(path): Path<String>) -> Response {
    // 防止目录穿越（虽然 rust-embed 查不到外部文件，但保持习惯）
    if path.split('/').any(|seg| seg == "..") {
        return (StatusCode::FORBIDDEN, "Invalid path").into_response();
    }
    let Some(res_embed) = Static::get(&path) else {
        return (StatusCode::NOT_FOUND, "Not found").into_response();
    };
    let content = std::str::from_utf8(res_embed.data.as_ref())
        .unwrap_or("")
        .to_string();

    
    // 根据文件名猜测 content-type；找不到则 application/octet-stream
    let mime = mime_guess::from_path(path).first_or_octet_stream();

    // 你可以按需增加更多头：Cache-Control / ETag / Last-Modified 等
    // 下面演示一个简单的缓存头（可按需调整策略）
    let headers = [
        (header::CONTENT_TYPE, mime.as_ref().to_string()),
        (
            header::CACHE_CONTROL,
            "public, max-age=86400, immutable".to_string(),// 1 天缓存，且内容不变（适合版本化资源）
        ),
    ];
    (StatusCode::OK, headers, content).into_response()
}
