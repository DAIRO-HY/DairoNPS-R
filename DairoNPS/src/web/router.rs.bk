/// 从查询参数中提取id
#[derive(Deserialize, Serialize, Debug)]
pub struct IdQuery {
    /// 当参数没有传时,使用默认值
    #[serde(default)]
    pub id: i64,
}

/// 从查询参数中获取一个参数
#[derive(Deserialize, Serialize, Debug)]
pub struct SingleQuery<T> {
    pub value: T,
}

pub fn ready() {
    tokio::spawn(init_router());
}

