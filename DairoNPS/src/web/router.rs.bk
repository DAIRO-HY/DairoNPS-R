async fn do_collect() -> &'static str {
    unsafe {
        crate::mi_collect(true);
    }
    "mi_collect_success"
}

async fn keep_live_on() -> &'static str {
    // tokio::time::sleep(tokio::time::Duration::from_secs(5)).await;
    "Hello, World!"
}

async fn keep_live_on_off() -> impl IntoResponse {
    ([(header::CONNECTION, "close")], "hello")
}


async fn image_resize() -> &'static str {
    image_util::resize(
        PathBuf::from("/Users/zhoulq/dev/java/idea/FarmingServer/test2/input.jpg"),
        300,
    )
    .unwrap()
    .jpeg(
        PathBuf::from("/Users/zhoulq/dev/java/idea/FarmingServer/test2/output_resize.jpg"),
        80,
    )
    .unwrap();
    image_util::crop(
        PathBuf::from("/Users/zhoulq/dev/java/idea/FarmingServer/test2/input.jpg"),
        300,
        300,
    )
    .unwrap()
    .jpeg(
        PathBuf::from("/Users/zhoulq/dev/java/idea/FarmingServer/test2/output_crop.jpg"),
        80,
    )
    .unwrap();
    "图片处理完成"
}

